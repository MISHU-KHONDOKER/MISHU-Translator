# ---------------------------------------------------------------
# MISHU Translator - private keys. Copy this file to ".env" and fill it in.
# NEVER share .env or paste its contents anywhere.
# ---------------------------------------------------------------

# --- Volcengine Ark (火山方舟) -------------------------------------
# Ark console -> API Key 管理 -> 创建 API Key
ARK_API_KEY=

# Text models used to translate in the "speech-to-text + LLM" routes
ARK_DOUBAO_MODEL=doubao-seed-2-1-lite-260915
ARK_DEEPSEEK_MODEL=deepseek-v4-1-flash-261017

# --- Doubao simultaneous interpretation (同声传译) free trial ---------------
# Old speech console -> 豆包同声传译大模型 -> 服务接口认证信息 (APP ID + Access Token).
# If empty, SPEECH_API_KEY is used (needs 同声传译2.0 activated in the new console).
SI_APP_ID=
SI_ACCESS_TOKEN=

# --- Doubao Speech (豆包语音) streaming speech recognition -------------
# New console: only the API Key is needed.
SPEECH_API_KEY=
# Old console instead: App ID + Access Token (leave SPEECH_API_KEY empty).
SPEECH_APP_ID=
SPEECH_ACCESS_TOKEN=
# Which ASR you enabled:
#   Doubao streaming ASR 2.0 (hourly): volc.seedasr.sauc.duration
#   Doubao streaming ASR 1.0 (hourly): volc.bigasr.sauc.duration
ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# --- Server ------------------------------------------------------
HTTPS_PORT=8443
HTTP_PORT=8080

# Optional: private access keys (comma-separated). If set, phones must enter one to use the app.
ACCESS_KEYS=

# --- Tutor (optional) ----------------------------------------------
# Model for lessons/stories (defaults to ARK_DOUBAO_MODEL)
ARK_TUTOR_MODEL=
# Doubao TTS 2.0 voice (default: zh_male_yuanboxiaoshu_uranus_bigtts)
TTS_VOICE=
